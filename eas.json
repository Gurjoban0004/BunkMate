{
    "cli": {
        "version": ">= 3.8.2"
    },
    "build": {
        "development": {
            "environment": "development",
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence-blue.vercel.app"
            }
        },
        "preview": {
            "environment": "preview",
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence-blue.vercel.app"
            }
        },
        "production": {
            "environment": "production",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence-blue.vercel.app"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
