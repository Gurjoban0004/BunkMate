{
    "cli": {
        "version": ">= 3.8.2"
    },
    "build": {
        "development": {
            "environment": "development",
            "developmentClient": true,
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence.runs-on.dev"
            },
            "channel": "development"
        },
        "preview": {
            "environment": "preview",
            "distribution": "internal",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence.runs-on.dev"
            },
            "channel": "preview"
        },
        "production": {
            "environment": "production",
            "android": {
                "buildType": "apk",
                "credentialsSource": "remote"
            },
            "env": {
                "EXPO_PUBLIC_API_BASE_URL": "https://presence.runs-on.dev"
            },
            "channel": "production"
        }
    },
    "submit": {
        "production": {}
    }
}
