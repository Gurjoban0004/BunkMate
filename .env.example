# ── Client (baked into the bundle — public by design, never secrets) ─────────
# Firebase web config. The apiKey is a project identifier, not a credential;
# access is decided by firestore.rules and the server.
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Native APK API host (the PWA is same-origin and ignores this). Set per EAS
# profile in eas.json; admin/config.apiBaseUrl can override it at runtime.
EXPO_PUBLIC_API_BASE_URL=https://presence-blue.vercel.app

# Public half of the VAPID pair, for the PWA's push subscription.
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# ── Server only (Vercel project env; never EXPO_PUBLIC_*) ────────────────────
ERP_BASE_URL=https://cuiet.codebrigade.in
ERP_SCHOOL_CODE=800002

# 32+ random characters. Rotating it invalidates every session/persistent token.
ENCRYPTION_SECRET=replace_with_32_plus_character_secret

# Comma-separated ERP roll numbers allowed to use the admin panel. No default.
ADMIN_ROLL_NUMBERS=

# Firebase service-account JSON (one line). Needed by everything that touches
# Firestore server-side and by /api/auth-token to sign custom tokens.
FIREBASE_SERVICE_ACCOUNT=

# Bearer secret for the /api/push-send cron. Vercel sends it automatically once
# set; without it the endpoint refuses every call (fails closed).
CRON_SECRET=

# Browser origins allowed to call /api/* cross-origin, comma-separated. The PWA
# is same-origin and native sends no Origin, so production can leave this empty.
# "*" is for local development only.
ALLOWED_ORIGIN=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:your-email@example.com

# Local dev only — enables the mock login (username "mock"). NEVER set in production.
# ALLOW_MOCK_LOGIN=1
