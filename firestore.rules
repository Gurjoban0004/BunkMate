rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── DEPLOY ORDER ──────────────────────────────────────────────────────
    // These rules require the app's custom-token auth (api/auth-token.js +
    // ensureAuthenticated) to be LIVE. Ship the app build → confirm sign-in works
    // → then deploy. Prereq: Firebase Authentication enabled on the project.
    //
    // Everything not matched below is denied. Collections written only by the
    // Admin SDK (which bypasses rules) are listed explicitly as denied anyway, so
    // the intent survives the next person adding a rule above them.
    // ──────────────────────────────────────────────────────────────────────

    // User data — a client may only touch its own document tree. The uid is the
    // login code, minted into a custom token server-side after code validation.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /semesters/{semId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Push subscriptions are written by api/push-subscribe (Admin SDK) after
      // it verifies the caller's ID token. No client path.
      match /push/{subId} {
        allow read, write: if false;
      }
    }

    // Rate-limit counters — server only.
    match /rateLimits/{counterId} {
      allow read, write: if false;
    }

    // Telemetry — clients append their own; reads happen server-side only.
    match /telemetry/{userId}/{document=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Research dataset (AI/ML class project) — Admin SDK only. The consenting
    // device writes through api/erp-calendar, api/erp-timetable and api/research.
    match /research/{document=**} {
      allow read, write: if false;
    }

    // Admin config — anyone can read (gates and the API base override need it),
    // only the server writes.
    match /admin/config {
      allow read: if true;
      allow write: if false;
    }

    // Announcements — anyone can read, only the server writes.
    match /admin/announcements/items/{annId} {
      allow read: if true;
      allow write: if false;
    }

    // Revoked users — server only. Revocation is enforced on every API call and
    // reported to the app by api/erp-session; the list itself is not public.
    match /admin/revokedUsers/items/{rollNumber} {
      allow read, write: if false;
    }

    // Admin audit trail and analytics cache — server only.
    match /admin/auditLog/{document=**} {
      allow read, write: if false;
    }
    match /admin/analyticsCache/{document=**} {
      allow read, write: if false;
    }
  }
}
