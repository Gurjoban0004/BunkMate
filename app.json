{
  "expo": {
    "name": "Presence",
    "slug": "presence",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "jsEngine": "hermes",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F8F4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.presence.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "package": "com.presence.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F9F8F4"
      },
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "FOREGROUND_SERVICE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Presence",
      "shortName": "Presence",
      "themeColor": "#F9F8F4",
      "backgroundColor": "#F9F8F4",
      "description": "Smart Attendance Tracker",
      "display": "standalone",
      "startUrl": "/app",
      "bundler": "metro",
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#F9F8F4"
      }
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#688E7F"
        }
      ],
      "expo-background-fetch",
      "expo-task-manager",
      "expo-font",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "ee79b872-6146-48c5-961e-806e5e54186a"
      }
    }
  }
}
